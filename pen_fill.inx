<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Pen Plotter Fill</name>
    <id>org.sayedho.penfill</id>

    <param name="tab" type="notebook">
        <page name="fill" gui-text="Fill">
            <param name="fill_mode" type="optiongroup" appearance="combo" gui-text="Fill style:">
                <option value="concentric">Concentric rings</option>
                <option value="spiral">Spiral (one stroke, fewest pen lifts)</option>
                <option value="archimedean">Round spiral</option>
                <option value="hatch">Hatch (straight lines)</option>
                <option value="crosshatch">Cross-hatch</option>
                <option value="sine">Waves</option>
                <option value="hilbert">Hilbert maze</option>
            </param>
            <param name="pen_size" type="float" precision="3" min="0.05" max="20.0" gui-text="Pen width (mm):">0.5</param>
            <param name="spacing_factor" type="float" precision="2" min="0.5" max="20.0" gui-text="Line spacing (× pen width):"
                   gui-description="1.0 = lines just touch for solid coverage. Bigger = lighter tone.">1.0</param>
            <param name="angle" type="float" precision="1" min="-180.0" max="180.0" gui-text="Line angle (°):"
                   gui-description="Direction of hatch, cross-hatch and wave lines.">45.0</param>
            <param name="outline" type="bool" gui-text="Also draw the outline"
                   gui-description="Traces the shape edge once, for a crisp border around hatch, wave, round-spiral and maze fills.">false</param>
            <param name="keep_inside" type="bool" gui-text="Keep ink inside the outline"
                   gui-description="Insets everything by half a pen width so the wet line never crosses the shape edge.">true</param>
            <param name="connect" type="bool" gui-text="Join lines into long strokes"
                   gui-description="Connects neighbouring hatch and wave lines — far fewer pen lifts.">true</param>
        </page>
        <page name="more" gui-text="More">
            <label appearance="header">Colour</label>
            <param name="color_mode" type="optiongroup" appearance="combo" gui-text="Stroke colour:">
                <option value="black">Black</option>
                <option value="shape">Same as the shape</option>
                <option value="custom">Custom</option>
            </param>
            <param name="custom_color" type="color" appearance="colorbutton" gui-text="Custom colour:">255</param>
            <param name="density_from_fill" type="bool" gui-text="Darker shapes get denser lines"
                   gui-description="Line spacing follows each shape's fill tone. Fill a grey-shaded drawing in one go for tonal art.">false</param>
            <label appearance="header">Cross-hatch and waves</label>
            <param name="cross_angle" type="float" precision="1" min="5.0" max="175.0" gui-text="Angle between the two passes (°):">90.0</param>
            <param name="sine_amplitude" type="float" precision="2" min="0.05" max="50.0" gui-text="Wave height (mm):">1.5</param>
            <param name="sine_wavelength" type="float" precision="2" min="0.5" max="200.0" gui-text="Wave length (mm):">6.0</param>
            <label appearance="header">When applying</label>
            <param name="replace" type="bool" gui-text="Replace the shape's earlier fill"
                   gui-description="Applying again swaps the old fill for the new one instead of stacking a second fill on top.">true</param>
            <param name="keep_original" type="bool" gui-text="Keep the original shape">true</param>
            <param name="show_stats" type="bool" gui-text="Show plot statistics">false</param>
        </page>
        <page name="help" gui-text="Help">
            <label appearance="header">Pen Plotter Fill v2.1</label>
            <label>Select closed shapes (paths, rectangles, ellipses, stars, clones — or groups of them) and apply. Each shape becomes pen strokes that fill it, one pen width apart.</label>
            <label>Holes work: a donut or the letter O fills correctly. Text: run Path ▸ Object to Path first.</label>
            <label>Spiral plots in one stroke. Hatch is the fastest. Raise line spacing for a lighter tone.</label>
            <label>Tip: the stroke width you see is your real pen width — what you see is what plots.</label>
            <label appearance="url">https://github.com/iret33/inkscape-pen-fill</label>
        </page>
    </param>

    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Pen Plotter"/>
        </effects-menu>
    </effect>

    <script>
        <command location="inx" interpreter="python">pen_fill.py</command>
    </script>
</inkscape-extension>
